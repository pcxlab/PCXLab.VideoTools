<?xml version="1.0" encoding="utf-8"?>

<Configuration>

  <ViewDefinitions>

    <!-- ========================================================= -->
    <!-- Video Information                                          -->
    <!-- ========================================================= -->

    <View>

      <Name>PCXLab.VideoInformation.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.VideoInformation</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <TableHeaders>

          <TableColumnHeader>
            <Label>File Name</Label>
            <Width>30</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Resolution</Label>
            <Width>14</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Video</Label>
            <Width>12</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Audio</Label>
            <Width>10</Width>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>FileName</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Resolution</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Duration</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>VideoCodec</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>AudioCodec</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>

    <!-- ========================================================= -->
    <!-- Silence                                                     -->
    <!-- ========================================================= -->

    <View>

      <Name>PCXLab.Silence.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.Silence</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <TableHeaders>

          <TableColumnHeader>
            <Label>Start</Label>
            <Width>14</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>End</Label>
            <Width>14</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>14</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Classification</Label>
            <Width>18</Width>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>Start</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>End</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Duration</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Classification</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>

    <!-- ========================================================= -->
    <!-- Audio Information                                          -->
    <!-- ========================================================= -->

    <View>

      <Name>PCXLab.AudioInformation.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.AudioInformation</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <TableHeaders>

          <TableColumnHeader>
            <Label>File Name</Label>
            <Width>30</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Codec</Label>
            <Width>10</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Channels</Label>
            <Width>10</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Sample Rate</Label>
            <Width>14</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Language</Label>
            <Width>10</Width>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>FileName</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Duration</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>AudioCodec</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Channels</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>SampleRate</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Language</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>

    <!-- ========================================================= -->
    <!-- Subtitle Information                                       -->
    <!-- ========================================================= -->

    <View>

      <Name>PCXLab.SubtitleInformation.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.SubtitleInformation</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <TableHeaders>

          <TableColumnHeader>
            <Label>File Name</Label>
            <Width>30</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Language</Label>
            <Width>10</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Codec</Label>
            <Width>12</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Default</Label>
            <Width>8</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Forced</Label>
            <Width>8</Width>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>FileName</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Language</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>SubtitleCodec</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Default</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Forced</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>

    <!-- ========================================================= -->
    <!-- Media Information                                          -->
    <!-- ========================================================= -->

    <View>

      <Name>PCXLab.MediaInformation.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.MediaInformation</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <TableHeaders>

          <TableColumnHeader>
            <Label>File Name</Label>
            <Width>30</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Resolution</Label>
            <Width>15</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Video</Label>
            <Width>10</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Audio</Label>
            <Width>10</Width>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>FileName</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Resolution</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Duration</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>VideoCodec</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>AudioCodec</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>

    <!-- ========================================================= -->
    <!-- Media Stream                                               -->
    <!-- ========================================================= -->

    <View>

      <Name>PCXLab.MediaStream.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.MediaStream</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <TableHeaders>

          <TableColumnHeader>
            <Label>Index</Label>
            <Width>6</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Type</Label>
            <Width>10</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Codec</Label>
            <Width>12</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Language</Label>
            <Width>10</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Default</Label>
            <Width>8</Width>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Forced</Label>
            <Width>8</Width>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>Index</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>StreamType</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Codec</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Language</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Default</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Forced</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>


    <View>
      <Name>PCXLab.SilenceReport.Default</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.SilenceReport</TypeName>
      </ViewSelectedBy>

      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>

              <ListItem>
                <Label>Source</Label>
                <PropertyName>Source</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Total Silences</Label>
                <PropertyName>TotalSilences</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Total Silent Seconds</Label>
                <PropertyName>TotalSilentSeconds</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Average Duration</Label>
                <PropertyName>AverageDuration</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Shortest Silence</Label>
                <PropertyName>ShortestSilence</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Longest Silence</Label>
                <PropertyName>LongestSilence</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Short Pauses</Label>
                <PropertyName>ShortPauses</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Edit Candidates</Label>
                <PropertyName>EditCandidates</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Recording Breaks</Label>
                <PropertyName>RecordingBreaks</PropertyName>
              </ListItem>

            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>

      <Name>PCXLab.SilenceReport</Name>

      <ViewSelectedBy>
        <TypeName>PCXLab.SilenceReport</TypeName>
      </ViewSelectedBy>

      <ListControl>

        <ListEntries>

          <ListEntry>

            <ListItems>

              <ListItem>
                <Label>Source</Label>
                <PropertyName>Source</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Total Silences</Label>
                <PropertyName>TotalSilences</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Total Silent Seconds</Label>
                <PropertyName>TotalSilentSeconds</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Average Duration</Label>
                <PropertyName>AverageDuration</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Shortest Silence</Label>
                <PropertyName>ShortestSilence</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Longest Silence</Label>
                <PropertyName>LongestSilence</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Short Pauses</Label>
                <PropertyName>ShortPauses</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Edit Candidates</Label>
                <PropertyName>EditCandidates</PropertyName>
              </ListItem>

              <ListItem>
                <Label>Recording Breaks</Label>
                <PropertyName>RecordingBreaks</PropertyName>
              </ListItem>

            </ListItems>

          </ListEntry>

        </ListEntries>

      </ListControl>

    </View>

  </ViewDefinitions>

</Configuration>